{
  "name": "otri",
  "version": "1.1.0",
  "description": "Otri: Fossil *O*stracod measuring using *tri*angles",
  "productName": "Otri",
  "author": "Eugeny Karasev <534temp@gmail.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint -c ./eslint.config.mjs \"./src*/**/*.{js,vue}\"",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "dev:electron": "quasar dev -m electron",
    "build": "quasar build",
    "build:electron": "quasar build -m electron",
    "build:electron:win64": "quasar build -m electron -T win32 --arch x64",
    "build:electron:win32": "quasar build -m electron -T win32 --arch ia32",
    "build:electron:debug": "quasar build -m electron -d",
    "build:electron:ui": "quasar build -m electron -s",
    "clean": "quasar clean",
    "package:win": "npm run build:electron && powershell Compress-Archive -Path \"dist/electron/Packaged/win-unpacked/*\" -DestinationPath \"dist/Otri_Windows_x64_Portable.zip\" -Force",
    "release:win": "npm run clean && npm run package:win"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "@svgdotjs/svg.draggable.js": "^3.0.3",
    "@svgdotjs/svg.js": "^3.2.0",
    "quasar": "^2.35.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.10.3",
    "@quasar/cli": "^5.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "autoprefixer": "^10.6.2",
    "electron-builder": "^26.8.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "postcss": "^8.5.9",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22.22.0",
    "npm": ">= 6.13.4"
  }
}
